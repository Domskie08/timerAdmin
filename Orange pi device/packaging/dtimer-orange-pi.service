[Unit]
Description=DTimer WiFi Orange Pi local controller
After=network-online.target dtimer-orange-pi-customer-lan.service
Wants=network-online.target dtimer-orange-pi-customer-lan.service

[Service]
Type=simple
User=dtimer
Group=dtimer
EnvironmentFile=-/etc/dtimer-orange-pi/dtimer.conf
WorkingDirectory=/opt/dtimer-orange-pi
ExecStart=/usr/bin/python3 /opt/dtimer-orange-pi/app.py --host ${DTIMER_HOST} --port ${DTIMER_PORT} --data-dir ${DTIMER_DATA_DIR}
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dtimer-orange-pi /var/log/dtimer-orange-pi
ReadOnlyPaths=/opt/dtimer-orange-pi /etc/dtimer-orange-pi
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
