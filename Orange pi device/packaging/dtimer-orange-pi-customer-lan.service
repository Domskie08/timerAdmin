[Unit]
Description=DTimer WiFi USB-to-LAN customer network
After=network-pre.target dnsmasq.service
Before=network-online.target dtimer-orange-pi.service
Wants=network-pre.target dnsmasq.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/dtimer-orange-pi/dtimer.conf
ExecStart=/opt/dtimer-orange-pi/scripts/configure_usb_customer_lan.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
